---
import '@fontsource/noto-sans-kr/400.css';
import '@fontsource/noto-sans-kr/500.css';
import '@fontsource/noto-sans-kr/700.css';
import '@fontsource/noto-serif-kr/600.css';
import '@fontsource/noto-serif-kr/700.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { loadAll } from '../lib/data.mjs';
import { u } from '../lib/url.mjs';

const { title, description, current, noindex = false } = Astro.props;
const { site, professor } = loadAll();
const fullName = `${site.university} ${site.department} ${site.name_ko}`;
const pageTitle = title ? `${title} | ${site.university} ${site.name_ko}` : `${fullName} (${site.name_en})`;
const desc = description ?? `${fullName}(지도교수 ${professor.name}) 홈페이지. ${site.intro.replace(/^.*?입니다\.\s*/, '')}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const abs = (p) => new URL(u(p), Astro.site).href;
// 검색엔진용 구조화 데이터 (연구 조직 정보)
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ResearchOrganization',
  name: fullName,
  alternateName: [site.name_ko, `공주대 ${site.name_ko}`, site.name_en],
  url: abs('/'),
  logo: abs('/logo.png'),
  email: site.contact.email,
  telephone: site.contact.tel,
  address: { '@type': 'PostalAddress', streetAddress: site.contact.address, addressCountry: 'KR' },
  parentOrganization: { '@type': 'CollegeOrUniversity', name: site.university, department: site.department },
  employee: { '@type': 'Person', name: professor.name, alternateName: professor.name_en, jobTitle: professor.position, email: professor.email },
  knowsAbout: site.research_topics,
};

const nav = [
  { key: 'about', label: '연구실 소개', href: u('/about') },
  { key: 'projects', label: '연구과제', href: u('/projects') },
  { key: 'publications', label: '연구성과', href: u('/publications') },
  { key: 'members', label: '구성원', href: u('/members') },
  { key: 'news', label: '소식', href: u('/news') },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={fullName} />
    <meta property="og:locale" content="ko_KR" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {site.google_site_verification && <meta name="google-site-verification" content={site.google_site_verification} />}
    {site.naver_site_verification && <meta name="naver-site-verification" content={site.naver_site_verification} />}
    <link rel="sitemap" href={u('/sitemap.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <meta property="og:image" content={new URL(u('/logo.png'), Astro.site).href} />
    <link rel="icon" href={u('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={u('/logo.png')} />
  </head>
  <body>
    <a class="skip" href="#content">본문 바로가기</a>
    <div class="util">
      <div class="wrap">
        {site.links.map((l, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true"></span>}
            <a href={l.url} target="_blank" rel="noopener">{l.label}</a>
          </>
        ))}
        <span class="sep" aria-hidden="true"></span>
        <a href={u('/about#location')}>오시는 길</a>
      </div>
    </div>
    <header class="header">
      <div class="wrap">
        <a class="brand" href={u('/')}>
          <img class="brand-logo" src={u('/logo.png')} alt="" width="58" height="58" />
          <span class="brand-text">
            <span class="brand-ko">{site.name_ko}</span>
            <span class="brand-en">{site.name_en}</span>
          </span>
        </a>
        <button class="menu-btn" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="gnb">
          <Icon name="menu" size={20} color="#0A4B4B" />
        </button>
        <nav class="gnb" id="gnb" aria-label="주 메뉴">
          {nav.map((n) => (
            <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <slot name="top" />

    <main class="wrap" id="content">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="col">
          <span class="name">{site.university} {site.name_ko}</span>
          {site.contact.address && <span>{site.contact.address}</span>}
          <span>
            {[site.contact.tel && `Tel ${site.contact.tel}`, site.contact.fax && `Fax ${site.contact.fax}`, site.contact.email && `E-mail ${site.contact.email}`]
              .filter(Boolean)
              .join(' · ')}
          </span>
          <span class="copy">© {site.name_en}, Kongju National University</span>
        </div>
        <div class="links">
          <div class="col">
            <span class="h">바로가기</span>
            {site.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label}</a>)}
          </div>
          <div class="col">
            <span class="h">사이트맵</span>
            {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          </div>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.querySelector('.menu-btn');
      const gnb = document.getElementById('gnb');
      btn?.addEventListener('click', () => {
        const open = gnb.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
      });
    </script>
  </body>
</html>
