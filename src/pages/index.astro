---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Authors from '../components/Authors.astro';
import Recruit from '../components/Recruit.astro';
import { loadAll, projectStatus, projectPeriod, sortByDateDesc, formatDate } from '../lib/data.mjs';
import { u } from '../lib/url.mjs';

const { site, professor, members, papers, projects, news } = loadAll();
const today = new Date();

const newsByCat = (c) => sortByDateDesc(news.filter((n) => n.category === c), 'date').slice(0, 5);
const tabs = [
  { key: 'media', label: '언론', items: newsByCat('언론') },
  { key: 'award', label: '수상', items: newsByCat('수상') },
  { key: 'notice', label: '공지', items: newsByCat('공지') },
];

// 최신 논문 4편 (파일 순서 유지, 연도 내림차순)
const recentPapers = [...papers].sort((a, b) => +b.year - +a.year).slice(0, 4);

// 진행 중 과제를 먼저, 그다음 시작일 최신순
const recentProjects = sortByDateDesc(projects, 'start')
  .map((p) => ({ ...p, status: projectStatus(p, today) }))
  .sort((a, b) => (a.status === b.status ? 0 : a.status === '진행' ? -1 : 1))
  .slice(0, 4);

---
<Base>
  <section class="hero" slot="top">
    <svg class="hero-mark" viewBox="0 0 200 200" aria-hidden="true">
      <g fill="none" stroke="#fff">
        <circle cx="100" cy="100" r="86" stroke-width="0.35" stroke-opacity="0.16" />
        <circle cx="100" cy="100" r="91" stroke-width="0.25" stroke-opacity="0.10" stroke-dasharray="0.6 2.4" />
        <path d="M100.00 14.00L100.00 20.00 M107.50 14.33L107.32 16.32 M114.93 15.31L114.59 17.28 M122.26 16.93L121.35 20.31 M129.41 19.19L128.73 21.07 M136.35 22.06L135.50 23.87 M143.00 25.52L141.25 28.55 M149.33 29.55L148.18 31.19 M155.28 34.12L153.99 35.65 M160.81 39.19L156.57 43.43 M165.88 44.72L164.35 46.01 M170.45 50.67L168.81 51.82 M174.48 57.00L171.45 58.75 M177.94 63.65L176.13 64.50 M180.81 70.59L178.93 71.27 M183.07 77.74L179.69 78.65 M184.69 85.07L182.72 85.41 M185.67 92.50L183.68 92.68 M186.00 100.00L180.00 100.00 M185.67 107.50L183.68 107.32 M184.69 114.93L182.72 114.59 M183.07 122.26L179.69 121.35 M180.81 129.41L178.93 128.73 M177.94 136.35L176.13 135.50 M174.48 143.00L171.45 141.25 M170.45 149.33L168.81 148.18 M165.88 155.28L164.35 153.99 M160.81 160.81L156.57 156.57 M155.28 165.88L153.99 164.35 M149.33 170.45L148.18 168.81 M143.00 174.48L141.25 171.45 M136.35 177.94L135.50 176.13 M129.41 180.81L128.73 178.93 M122.26 183.07L121.35 179.69 M114.93 184.69L114.59 182.72 M107.50 185.67L107.32 183.68 M100.00 186.00L100.00 180.00 M92.50 185.67L92.68 183.68 M85.07 184.69L85.41 182.72 M77.74 183.07L78.65 179.69 M70.59 180.81L71.27 178.93 M63.65 177.94L64.50 176.13 M57.00 174.48L58.75 171.45 M50.67 170.45L51.82 168.81 M44.72 165.88L46.01 164.35 M39.19 160.81L43.43 156.57 M34.12 155.28L35.65 153.99 M29.55 149.33L31.19 148.18 M25.52 143.00L28.55 141.25 M22.06 136.35L23.87 135.50 M19.19 129.41L21.07 128.73 M16.93 122.26L20.31 121.35 M15.31 114.93L17.28 114.59 M14.33 107.50L16.32 107.32 M14.00 100.00L20.00 100.00 M14.33 92.50L16.32 92.68 M15.31 85.07L17.28 85.41 M16.93 77.74L20.31 78.65 M19.19 70.59L21.07 71.27 M22.06 63.65L23.87 64.50 M25.52 57.00L28.55 58.75 M29.55 50.67L31.19 51.82 M34.12 44.72L35.65 46.01 M39.19 39.19L43.43 43.43 M44.72 34.12L46.01 35.65 M50.67 29.55L51.82 31.19 M57.00 25.52L58.75 28.55 M63.65 22.06L64.50 23.87 M70.59 19.19L71.27 21.07 M77.74 16.93L78.65 20.31 M85.07 15.31L85.41 17.28 M92.50 14.33L92.68 16.32" stroke-width="0.35" stroke-opacity="0.18" />
        <circle cx="100" cy="100" r="40" stroke-width="0.3" stroke-opacity="0.10" />
      </g>
      <circle cx="100" cy="100" r="62" fill="none" stroke="#fff" stroke-width="0.4" stroke-opacity="0.14" />
      <g fill="#fff">
        <polygon points="100,100 139,61 108,92" opacity="0.05" /><polygon points="100,100 108,108 139,139" opacity="0.08" />
        <polygon points="100,100 61,139 92,108" opacity="0.05" /><polygon points="100,100 92,92 61,61" opacity="0.08" />
        <polygon points="100,100 100,6 114,86" opacity="0.10" /><polygon points="100,100 86,86 100,6" opacity="0.05" />
        <polygon points="100,100 194,100 114,114" opacity="0.10" /><polygon points="100,100 114,86 194,100" opacity="0.05" />
        <polygon points="100,100 100,194 86,114" opacity="0.10" /><polygon points="100,100 114,114 100,194" opacity="0.05" />
        <polygon points="100,100 6,100 86,86" opacity="0.10" /><polygon points="100,100 86,114 6,100" opacity="0.05" />
      </g>
    </svg>
    <div class="wrap">
      <div class="hero-text">
        <span class="hero-kicker">{site.university} {site.college} {site.department}</span>
        <h1>{site.name_ko}</h1>
        <span class="hero-en">{site.name_en}</span>
        {site.slogan && <p class="hero-slogan">{site.slogan}</p>}
      </div>
      <nav class="quick" aria-label="바로가기">
        <a href={u('/projects')}><Icon name="doc" color="#fff" />연구과제</a>
        <a href={u('/publications')}><Icon name="book" color="#fff" />게재 논문</a>
        <a href={u('/members')}><Icon name="people" color="#fff" />구성원</a>
        <a href={u('/about#location')}><Icon name="pin" color="#fff" />오시는 길</a>
      </nav>
    </div>
  </section>

  <div class="board-grid">
    <section>
      <div class="board-head">
        <div class="tabs" role="tablist" aria-label="소식">
          {tabs.map((t, i) => (
            <button class="tab" type="button" role="tab" id={`tab-${t.key}`} aria-controls={`panel-${t.key}`} aria-selected={i === 0 ? 'true' : 'false'}>{t.label}</button>
          ))}
        </div>
        <a class="more" href={u('/news')}>더보기 +</a>
      </div>
      {tabs.map((t, i) => (
        <div role="tabpanel" id={`panel-${t.key}`} aria-labelledby={`tab-${t.key}`} hidden={i !== 0}>
          {t.items.length ? (
            <ul class="list">
              {t.items.map((n) => (
                <li>
                  {n.url ? <a class="t" href={n.url} target="_blank" rel="noopener">{n.title}</a> : <span class="t">{n.title}</span>}
                  <span class="m">{[n.source, formatDate(n.date)].filter(Boolean).join(' · ')}</span>
                </li>
              ))}
            </ul>
          ) : (
            <div class="empty">등록된 {t.label} 소식이 없습니다.</div>
          )}
        </div>
      ))}
    </section>

    <section>
      <div class="board-head">
        <h2>최근 게재 논문</h2>
        <a class="more" href={u('/publications')}>더보기 +</a>
      </div>
      <ul class="list">
        {recentPapers.map((p) => (
          <li>
            {p.url ? <a class="t" href={p.url} target="_blank" rel="noopener">{p.title}</a> : <span class="t">{p.title}</span>}
            <span class="m"><Authors authors={p.authors} /> · <em>{p.journal}</em> {p.year}</span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <div class="board-head">
        <h2>연구과제</h2>
        <a class="more" href={u('/projects')}>더보기 +</a>
      </div>
      <ul class="list">
        {recentProjects.map((p) => (
          <li class="row">
            <span class={`badge ${p.status === '진행' ? 'on' : ''}`}>{p.status}</span>
            <span>
              <span class="t" style="display:block">{p.title}</span>
              <span class="m">{[projectPeriod(p), p.role].filter(Boolean).join(' · ')}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <Recruit />

  {site.research_topics.length > 0 && (
    <section>
      <h2 class="section-title">연구 분야</h2>
      {site.research_summary && <p class="research-summary">{site.research_summary}</p>}
      <ul class="topics">{site.research_topics.map((t) => <li>{t}</li>)}</ul>
    </section>
  )}

  <div class="prof-row">
    <section class="prof">
      <div class="photo">{professor.photo ? <img src={u(`/photos/${professor.photo}`)} alt={`${professor.name} 교수`} /> : <Icon name="person" size={40} color="#8A919C" />}</div>
      <div class="prof-body">
        <div class="prof-name">
          <span><span class="n">{professor.name}</span><span class="p">{professor.position}</span></span>
          <a class="small" href={u('/about#professor')}>교수 소개 +</a>
        </div>
        <div class="prof-facts">
          {professor.highlights.map((t) => <span>{t}</span>)}
        </div>
        <span class="small">{[professor.email, professor.tel].filter(Boolean).join(' · ')}</span>
      </div>
    </section>
  </div>
</Base>

<script>
  const tabs = document.querySelectorAll('[role="tab"]');
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
      });
    }),
  );
</script>
