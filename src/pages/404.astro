---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { u } from '../lib/url.mjs';
---
<Base title="페이지를 찾을 수 없습니다">
  <PageHead title="페이지를 찾을 수 없습니다" slot="top" />
  <section>
    <p style="margin:0 0 16px;font-size:16px">요청하신 페이지가 없거나 주소가 바뀌었습니다.</p>
    <a href={u('/')} style="color:var(--blue)">홈으로 가기 →</a>
  </section>
</Base>
